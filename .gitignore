# TypeScript incremental build cache
*.tsbuildinfo

# Data / secrets
*.db
*.db-shm
*.db-wal
.env
.env.local
/data/          # root-level runtime data dir only — must NOT match src/Themearr.API/Data/

# Build outputs
_publish/
_dist/

# OS
.DS_Store
Thumbs.db

# Temp
*.tmp
*.log

# Playwright MCP session artifacts (snapshots, screenshots, console logs)
.playwright-mcp/

# E2E suite (tests/e2e) — deps and run artifacts. The lockfile IS committed so CI
# can `npm ci`.
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/blob-report/
